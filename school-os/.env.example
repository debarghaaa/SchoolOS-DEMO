# Live presence feed (Supabase). See supabase/README.md for setup.
# Until these are set, the presence islands render their not-configured state.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI base for the feed login + token exchange. Same-origin /api through
# the Vite proxy by default; set only to point at a remote backend.
# VITE_API_BASE=http://localhost:8000
