# SchoolOS API — copy to .env and fill in. NEVER commit real secrets.
# Every variable has a dev default; production MUST override SECRET_KEY,
# database, Redis and storage credentials via the deployment environment
# (secret manager / orchestrator secrets), never files or images.

# --- Environment ---
ENV=dev # dev | test | prod
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database (PostgreSQL in production; SQLite for zero-config local dev) ---
DATABASE_URL=postgresql+psycopg2://schoolos:schoolos@localhost:5432/schoolos
# DATABASE_URL=sqlite:///./dev.db

# Per-process connection pool. Size replicas so that
# replicas * (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Compose-managed Postgres credentials (also used to build DATABASE_URL).
POSTGRES_USER=schoolos
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=schoolos

# --- Redis (queue, cache, rate limiting, ephemeral state only) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_HOURS=48
BCRYPT_ROUNDS=12

# --- API ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=300

# --- Logging (text for dev, json for prod aggregation) ---
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Workers ---
# Comma-separated queues this worker drains: default, elab.
# General workers: default. E-Lab workers on isolated hosts: elab.
WORKER_QUEUES=default,elab
# Migrations run in the entrypoint; exactly one replica (compose: api)
# should migrate. Orchestrated prod migrates via initContainer/Job.
RUN_MIGRATIONS=true

# --- Storage (files live outside app containers) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=schoolos
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Compose-managed MinIO credentials.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# --- E-Lab (untrusted code runs ONLY in throwaway containers) ---
ELAB_BACKEND=docker
ELAB_ALLOW_INSECURE_LOCAL=false
ELAB_TIMEOUT_SECONDS=5
ELAB_MAX_OUTPUT_KB=64
ELAB_MAX_SOURCE_KB=100
ELAB_MAX_STDIN_KB=32
ELAB_LANGUAGES=python,javascript,c,cpp
ELAB_MEMORY_MB=256
ELAB_CPU_QUOTA=50000
ELAB_PIDS_LIMIT=64
ELAB_IMAGE_PYTHON=schoolos/elab-python:1.0
ELAB_IMAGE_JAVASCRIPT=schoolos/elab-node:1.0
ELAB_IMAGE_C=schoolos/elab-gcc:1.0
ELAB_IMAGE_CPP=schoolos/elab-gcc:1.0
ELAB_RETAIN_SOURCE=false
ELAB_SOURCE_RETENTION_DAYS=30
ELAB_MAX_CONCURRENT_PER_USER=3
ELAB_DAILY_RUNS_PER_USER=100
ELAB_DAILY_RUNS_PER_TENANT=5000

# --- Email (console in dev; wire SMTP/SES for production) ---
EMAIL_BACKEND=console

# --- Presence feed (optional; islands degrade gracefully when unset) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
